project Hunt_The_Wumpus is

   for Main use ("Wumpus.adb");

   --  Source_Dirs includes ".." to pick up Turtle_Graphics (stub) from the root
   for Source_Dirs use (".", "..");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";

   --  Mixed-case filenames; register explicitly so Linux CI finds them.
   package Naming is
      for Body ("Wumpus") use "Wumpus.adb";
      for Spec ("Project2Pack") use "Project2Pack.ads";
      for Body ("Project2Pack") use "Project2Pack.adb";
   end Naming;

end Hunt_The_Wumpus;
